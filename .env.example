# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://finops:finops@localhost:5432/finopstrading

# --- Sessions ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=changeme-generate-a-random-64-char-hex-string

# --- Credential encryption (Dhan client_id / access_token at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=changeme-generate-a-fernet-key

# --- App ---
SUPERADMIN_EMAIL=baluinbox@gmail.com
ENV=development

# --- Strategy engine ---
# Seconds between evaluation passes for active user strategies
STRATEGY_POLL_INTERVAL_SECONDS=30
# Master switch: when false, no live orders can ever be placed, only paper mode.
ALLOW_LIVE_TRADING=false

# --- Onboarding info shown on the Settings page ---
# The GCP VM's static outbound IP, once provisioned. Users must whitelist this
# IP on their own Dhan account before order placement/modification/cancellation
# will work. Leave blank while developing locally.
SERVER_STATIC_IP=
