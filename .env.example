# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://finops:finops@localhost:5432/finopstrading

# --- Sessions ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=changeme-generate-a-random-64-char-hex-string

# --- Credential encryption (Dhan client_id / access_token at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=changeme-generate-a-fernet-key

# --- App ---
SUPERADMIN_EMAIL=baluinbox@gmail.com
ENV=development
# Empty locally (app served at the domain root). Set to e.g. "/finopsdhan"
# when hosted behind a reverse proxy under a path prefix, alongside other
# products on the same domain/IP. No trailing slash.
BASE_PATH=

# --- Strategy engine ---
# Seconds between evaluation passes for active user strategies
STRATEGY_POLL_INTERVAL_SECONDS=30
# Master switch: when false, no live orders can ever be placed, only paper mode.
ALLOW_LIVE_TRADING=false

# --- Onboarding info shown on the Settings page ---
# The GCP VM's static outbound IP, once provisioned. Users must whitelist this
# IP on their own Dhan account before order placement/modification/cancellation
# will work. Leave blank while developing locally.
SERVER_STATIC_IP=

# --- Outbound email (account verification, password reset) ---
# Gmail example: SMTP_USERNAME is the full Gmail address, SMTP_PASSWORD is
# a 16-character Google "App Password" (Google Account -> Security -> 2-Step
# Verification -> App passwords) — NOT your normal Gmail login password.
# Leave SMTP_HOST blank to disable email sending entirely (the app logs a
# warning and continues instead of crashing registration/password-reset).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Optional: also ties the session cookie's Secure flag to ENV=production by
# default. Set explicitly to false if this production deployment is served
# over plain HTTP (no TLS certificate) behind a reverse proxy — a Secure
# cookie is silently dropped by every browser on a non-HTTPS connection,
# which breaks login entirely with no error shown anywhere.
# SESSION_COOKIE_SECURE=false

# --- Docker Compose host port overrides (docker-compose.yml only) ---
# Only needed if the default host ports (8000, 5432) are already taken by
# something else on the machine, e.g. when sharing a VM with other apps.
# APP_HOST_PORT=8010
# DB_HOST_PORT=5433
